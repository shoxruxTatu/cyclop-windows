<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004: the floor for the system media session API
         the Music tab reads. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on macOS and Linux too (CI, the Mac it is made on). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Cyclop</RootNamespace>
    <AssemblyName>Cyclop</AssemblyName>
    <ApplicationIcon>Assets\cyclop.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Cyclop.Program</StartupObject>
    <Version>0.9.0</Version>
    <Product>Cyclop</Product>
    <Company>@shoxrux.edit</Company>
    <Authors>@shoxrux.edit</Authors>
    <Copyright>MIT · Windows version @shoxrux.edit · Cyclop for macOS Adil Kalikbergenov</Copyright>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- DPI awareness is declared in app.manifest for the WPF windows; WinForms
         is here only for the tray icon and the folder picker. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyclop.Core\Cyclop.Core.csproj" />
    <!-- Release builds get the update server's address from CI
         (-p:UpdateServer=https://…); a local build has none and never
         contacts anyone. -->
    <AssemblyMetadata Include="UpdateServer" Value="$(UpdateServer)" Condition="'$(UpdateServer)' != ''" />
    <Resource Include="Assets\cyclop.ico" />
  </ItemGroup>

</Project>
